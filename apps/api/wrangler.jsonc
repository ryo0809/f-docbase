{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "f-docbase",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  // 画面(静的ファイル)は ASSETS で配信し、/api/* だけを Worker で処理する。
  // 静的ファイルの配信には CPU 時間がかからない。
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  // database_id は秘密ではない。CI(GitHub Actions)でも同じ D1 に確実につながるよう、明示している。
  // 別のアカウントで一から作るときは、database_id を消して deploy すると D1 が自動作成される。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "f-docbase",
      "database_id": "5f8279d2-a1f0-4009-b22c-cd87cae16d17",
      "migrations_dir": "migrations"
    }
  ]
}
