{
  "name": "f-docbase",
  "version": "0.2.0",
  "private": true,
  "description": "Personal document web app for requirements and design docs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @f-docbase/web",
    "deploy": "npm run build && npm run deploy -w @f-docbase/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
