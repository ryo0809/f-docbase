{
  "name": "f-docbase",
  "version": "0.2.0",
  "private": true,
  "description": "Personal document web app for requirements and design docs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @f-docbase/web",
    "deploy": "npm run build && npm run deploy -w @f-docbase/api",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @f-docbase/api",
    "migrate:local": "npm run migrate:local -w @f-docbase/api",
    "import-docs": "node apps/api/scripts/import-docs.mjs",
    "import-docs:local": "node apps/api/scripts/import-docs.mjs --local",
    "reset-password": "node apps/api/scripts/reset-password.mjs",
    "reset-password:local": "node apps/api/scripts/reset-password.mjs --local",
    "seed:local": "node apps/api/scripts/seed-local.mjs",
    "sync-docs": "node apps/api/scripts/sync-docs.mjs",
    "export-docs": "node apps/api/scripts/export-docs.mjs"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
